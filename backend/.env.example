# Copia este archivo a .env y cambia los valores. El .env NO se sube a GitHub.
# en la VM el .env va en la raiz del repo junto a compose.yaml
# la clave solo con letras y numeros para no romper la URL
POSTGRES_USER=so
POSTGRES_PASSWORD=CambiaEstaClave123
POSTGRES_DB=so
# el host es db (nombre del servicio de la base en compose.yaml)
DATABASE_URL=postgresql://so:CambiaEstaClave123@db:5432/so
ORIGEN_PERMITIDO=https://gNN.dominio-del-curso
